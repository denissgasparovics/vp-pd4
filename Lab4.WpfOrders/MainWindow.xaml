<Window x:Class="Lab4.WpfOrders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:viewModels="clr-namespace:Lab4.WpfOrders.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:OrderListViewModel}"
        Title="Studenti" Height="450" Width="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <Label Content="Pasūtījumi" FontWeight="Bold" />
                <Button Content="Atjaunot" Width="90" Margin="10,2,0,2"
                        Command="{Binding LoadOrdersCommand}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Margin="0,5,0,0"
                       Text="Neviens pasūtījums nav atrasts."
                       Visibility="{Binding IsCollectionEmpty,
                                    Converter={StaticResource BoolToVisibility}}" />

            <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Numurs:" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                 Text="{Binding SearchOrderNumber, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="1" Grid.Column="0" Content="Datums:" />
                <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,2"
                    SelectedDate="{Binding SearchOrderDate}" />

                <Label Grid.Row="2" Grid.Column="0" Content="Statuss:" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2"
                  ItemsSource="{Binding StatusOptions}"
                  SelectedItem="{Binding SearchStatus}" />

                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Meklēt" Width="80" IsDefault="True"
                    Command="{Binding SearchOrderCommand}" />
                    <Button Content="Notīrīt" Width="80" Margin="10,0,0,0"
                    Command="{Binding ClearSearchOrderCommand}" />
                </StackPanel>
            </Grid>

            <DataGrid AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      ItemsSource="{Binding Orders}"
                      SelectedItem="{Binding SelectedOrder, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Numurs" Width="80"
                                        Binding="{Binding OrderNumber}" />
                    <DataGridTextColumn Header="Datums" Width="*"
                                        Binding="{Binding OrderDate}" />
                    <DataGridTextColumn Header="Statuss" Width="*"
                                        Binding="{Binding Status}" />
                </DataGrid.Columns>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding SelectOrderCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </DataGrid>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <Label DockPanel.Dock="Top" Content="Pasūtījuma preces" FontWeight="Bold" />
            <DataGrid AutoGenerateColumns="False"
                      IsReadOnly="True"
                      ItemsSource="{Binding OrderItems}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produkta nosaukums" Width="*"
                                        Binding="{Binding ProductName}" />
                    <DataGridTextColumn Header="Vienības cena" Width="*"
                                        Binding="{Binding UnitPrice}" />
                    <DataGridTextColumn Header="Daudzums" Width="80"
                                        Binding="{Binding Quantity}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>